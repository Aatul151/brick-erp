# Application Configuration
NODE_ENV=development # or production
FRONTEND_PORT=**PORT_NUMBER**
BACKEND_PORT=**PORT_NUMBER**

# Frontend URL
VITE_API_URL=http://localhost:**PORT_NUMBER**

# Backend Configuration
API_URL=http://localhost:**PORT_NUMBER**

# Database Configuration
DB_HOST=**HOST_NAME**   
DB_PORT=**PORT_NUMBER**
DB_NAME=**DATABASE_NAME**
DB_USER=**DATABASE_USER**
DB_PASSWORD=**DATABASE_PASSWORD**

# JWT Configuration
JWT_SECRET=**JWT_SECRET**
JWT_ACCESS_EXPIRY=4h
JWT_REFRESH_EXPIRY=30d

# SendGrid Configuration (Optional - for email notifications)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=**SENDGRID_FROM_NAME**

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_WINDOW=60
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_API_WINDOW=60

# Default Site Admin
DEFAULT_ADMIN_EMAIL=**DEFAULT_ADMIN_EMAIL**
DEFAULT_ADMIN_PASSWORD=**DEFAULT_ADMIN_PASSWORD**
DEFAULT_ADMIN_NAME=**DEFAULT_ADMIN_NAME**

# Session Configuration
SESSION_SECRET=**SESSION_SECRET**
