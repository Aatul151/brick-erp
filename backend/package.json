{
    "name": "brick-erp-backend",
    "version": "1.0.0",
    "type": "module",
    "description": "Brick ERP backend",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "push": "dotenv -e ../.env -- npx drizzle-kit push",
        "migrate": "dotenv -e ../.env -- npx drizzle-kit migrate",
        "format": "npx prettier \"**/*.{js,jsx,ts,tsx,json,css,md}\" --write"
    },
    "dependencies": {
        "@sendgrid/mail": "^8.1.0",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^17.3.1",
        "drizzle-orm": "^0.45.2",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "pg": "^8.20.0",
        "promisify-child-process": "^5.0.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "dotenv-cli": "^11.0.0",
        "drizzle-kit": "^0.31.10",
        "nodemon": "^3.0.2"
    }
}
